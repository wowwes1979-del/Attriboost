[worldserver]

########################################
# TortugaTomes Configuration
########################################
#
#    TortugaTomes.Enable
#        Description: Enable/Disable the librarian/bonus attributes.
#        Default:     0 - Disabled
#                     1 - Enabled
#

TortugaTomes.Enable = 0

#
#    TortugaTomes.ResetCost
#        Description: The cost of resetting attributes in copper.
#        Default:     2500000 (250 gold)
#

TortugaTomes.ResetCost = 2500000

#
#    TortugaTomes.DisablePvP
#        Description: Enable/Disable the attributes in PvP combat.
#                     0 - Disabled
#        Default:     1 - Enabled
#

TortugaTomes.DisablePvP = 1

#
#    TortugaTomes.Max.*
#        Description: The max value each attribute can be allocated.
#        Default:     100
#

TortugaTomes.Max.Stamina = 100
TortugaTomes.Max.Strength = 100
TortugaTomes.Max.Agility = 100
TortugaTomes.Max.Intellect = 100
TortugaTomes.Max.Spirit = 100
TortugaTomes.Max.SpellPower = 100
